# GGbot configuration example
# Copy to .ggbot/config.toml and customize as needed
# Environment variables take precedence over this file

# ============================================================================
# LLM Configuration
# ============================================================================

[openai]
# Model name (passed to LiteLLM)
model = "gpt-4.1-mini"

# API key for OpenAI-compatible providers
api_key = "sk-your-key-here"

# Base URL for OpenAI-compatible APIs
base_url = "https://api.openai.com/v1"

# ============================================================================
# GGbot Core Configuration
# ============================================================================

[ggbot]
# Workspace root directory (sandbox boundary)
workspace_root = "."

# Maximum conversation turns per query
max_turns = 8

# Tool call safety limits
max_tool_calls = 30
max_tool_calls_per_tool = 20
max_tool_calls_same_args = 3

# Thinking/Reasoning functionality
# When enabled, GGbot will extract and display model's reasoning process
thinking_enabled = false

# ============================================================================
# Prompt Configuration
# ============================================================================

[prompt]
# Prompt profile name (corresponds to .ggbot/prompts/<profile>.md)
profile = "default"

# Custom prompt directory (optional)
# dir = "./custom-prompts"

# ============================================================================
# Transcript Configuration
# ============================================================================

[transcript]
# Transcript directory (optional)
# dir = "./.ggbot/transcripts"

# ============================================================================
# Shell Tool Configuration
# ============================================================================

[shell]
# Require confirmation for shell commands
confirm = true

# Maximum execution time in milliseconds
timeout_ms = 30000

# Maximum output size in characters
max_output_chars = 30000

# ============================================================================
# Example Configurations
# ============================================================================

# Example 1: Enable thinking with local model
# [openai]
# model = "ollama/llama3.2"
# base_url = "http://localhost:11434"
# api_key = "ollama"
#
# [ggbot]
# thinking_enabled = true

# Example 2: Use Claude with thinking
# [openai]
# model = "claude-3-5-sonnet-20241022"
# # Note: For Anthropic, also set ANTHROPIC_API_KEY in .env
#
# [ggbot]
# thinking_enabled = true

# Example 3: Azure OpenAI
# [openai]
# model = "azure/gpt-4"
# # Note: For Azure, also set AZURE_API_KEY and AZURE_API_BASE in .env

# Example 4: Strict safety settings
# [ggbot]
# max_tool_calls = 10
# max_tool_calls_per_tool = 5
# max_tool_calls_same_args = 2
#
# [shell]
# confirm = true
# timeout_ms = 10000
# max_output_chars = 10000

# ============================================================================
# Notes
# ============================================================================

# 1. Priority order (highest to lowest):
#    - Command-line arguments
#    - Environment variables (.env files)
#    - This config.toml file
#    - Default values
#
# 2. For provider-specific settings (Anthropic, Azure, etc.):
#    - Use environment variables in .env file
#    - Or set them directly in your shell
#
# 3. Thinking functionality:
#    - Requires thinking_enabled = true
#    - Works best with models that support reasoning
#    - Or models that follow the thinking format in prompts
#
# 4. File paths can be absolute or relative to workspace_root
#
# 5. Session management:
#    - chat: One-off conversations
#    - repl: Interactive REPL mode
#    - tui: Terminal UI with pets and visual features