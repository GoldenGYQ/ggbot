# GGbot example environment
# Copy to repo root as `.env` or to `./.ggbot/.env`

# --- LLM defaults (optional) ---
# GGbot uses LiteLLM under the hood.
#
# These OPENAI_* variables are treated as *defaults* passed into LiteLLM.
# - For OpenAI/OpenAI-compatible gateways: set OPENAI_API_KEY (and optionally OPENAI_BASE_URL).
# - For other providers (Anthropic/Gemini/Azure/etc): LiteLLM typically reads provider-specific env vars.

# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- GGbot behavior (optional) ---
# GGBOT_MAX_TURNS=8

# Workspace sandbox root (optional; default is current working dir)
# GGBOT_WORKSPACE_ROOT=D:/path/to/your/workspace

# Transcript dir (optional; default: <workspace>/.ggbot/transcripts)
# GGBOT_TRANSCRIPT_DIR=D:/path/to/transcripts

# --- Shell tool safety (optional) ---
# If true, every `shell_run` asks for confirmation.
# GGBOT_SHELL_CONFIRM=true
# GGBOT_SHELL_TIMEOUT_MS=30000
# GGBOT_SHELL_MAX_OUTPUT_CHARS=30000
