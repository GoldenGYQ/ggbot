# GGbot example environment
# Copy to `~/.ggbot/.env` (recommended global config location)
# Remove the '#' prefix to enable a setting

# ============================================================================
# LLM Configuration (via LiteLLM)
# ============================================================================

# GGbot uses LiteLLM under the hood for multi-provider support.
# These OPENAI_* variables are treated as *defaults* passed into LiteLLM.

# For OpenAI/OpenAI-compatible gateways:
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# For other providers (Anthropic/Gemini/Azure/etc), LiteLLM typically reads
# provider-specific env vars. Examples:
# ANTHROPIC_API_KEY=your-anthropic-key
# GEMINI_API_KEY=your-gemini-key
# AZURE_API_KEY=your-azure-key
# AZURE_API_BASE=your-azure-endpoint
# AZURE_API_VERSION=2024-02-15-preview
# COHERE_API_KEY=your-cohere-key
# TOGETHERAI_API_KEY=your-togetherai-key
# MISTRAL_API_KEY=your-mistral-key
# BEDROCK_AWS_ACCESS_KEY_ID=your-aws-access-key
# BEDROCK_AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# BEDROCK_AWS_REGION_NAME=us-east-1
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ============================================================================
# Core GGbot Behavior
# ============================================================================

# Maximum conversation turns per query (prevents infinite loops)
GGBOT_MAX_TURNS=8

# Tool call limits (safety measures)
GGBOT_MAX_TOOL_CALLS=30
GGBOT_MAX_TOOL_CALLS_PER_TOOL=20
GGBOT_MAX_TOOL_CALLS_SAME_ARGS=3

# Thinking/Reasoning functionality
# When enabled, GGbot will extract and display model's reasoning process
GGBOT_THINKING_ENABLED=false

# ============================================================================
# Workspace & File System
# ============================================================================

# Workspace sandbox root (default: ~/.ggbot/workspace)
# All file operations are restricted to this directory and its subdirectories
# GGBOT_WORKSPACE_ROOT=D:/path/to/your/workspace

# Transcript directory (default: ~/.ggbot/transcripts)
# Where conversation transcripts are stored
# GGBOT_TRANSCRIPT_DIR=D:/path/to/transcripts



# ============================================================================
# Prompt Engineering
# ============================================================================

# Prompt profile name (default: "default")
# Corresponds to ~/.ggbot/prompts/<profile>.md files
# GGBOT_PROMPT_PROFILE=default

# Custom prompt directory (default: ~/.ggbot/prompts)
# GGBOT_PROMPT_DIR=D:/path/to/custom/prompts

# ============================================================================
# Shell Tool Safety
# ============================================================================

# If true, every `shell_run` asks for confirmation before execution
GGBOT_SHELL_CONFIRM=true

# Maximum execution time for shell commands (milliseconds)
GGBOT_SHELL_TIMEOUT_MS=30000

# Maximum output size for shell commands (characters)
GGBOT_SHELL_MAX_OUTPUT_CHARS=30000

# ============================================================================
# Usage Examples
# ============================================================================

# Example 1: Enable thinking with GPT-4
# OPENAI_MODEL=gpt-4
# GGBOT_THINKING_ENABLED=true

# Example 2: Use Claude with thinking enabled
# OPENAI_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=your-anthropic-key
# GGBOT_THINKING_ENABLED=true

# Example 3: Local Ollama instance
# OPENAI_MODEL=ollama/llama3.2
# OPENAI_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=ollama  # Some local setups don't require a key

# Example 4: Azure OpenAI
# OPENAI_MODEL=azure/gpt-4
# AZURE_API_KEY=your-azure-key
# AZURE_API_BASE=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-02-15-preview

# Example 5: Strict safety settings
# GGBOT_SHELL_CONFIRM=true
# GGBOT_MAX_TOOL_CALLS=10
# GGBOT_MAX_TOOL_CALLS_PER_TOOL=5
# GGBOT_MAX_TOOL_CALLS_SAME_ARGS=2

# ============================================================================
# Notes
# ============================================================================

# 1. Environment variables take precedence over config.toml settings
# 2. Command-line arguments take precedence over environment variables
# 3. For thinking functionality to work properly:
#    - Set GGBOT_THINKING_ENABLED=true
#    - The model should support reasoning/thinking output
#    - Or use a model that follows the thinking format in prompts
# 4. Transcript files are stored as JSONL in the transcript directory
# 5. Session types: chat (one-off), repl (interactive), tui (terminal UI)
